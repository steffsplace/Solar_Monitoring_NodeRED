    "name": "Old Set Boiler Target Temp",
    "func": "msg.payload.newWaterTemp = msg.payload.boilerState.attributes.temperature;\n\n// Heatpump is not running or is heating\nif (msg.payload.heatpumpState.state == \"no request\" || msg.payload.heatpumpState.state == \"heating\") {\n\n    // Turn on, if enough energy available and the water temp is low\n    if (\n        msg.payload.power > flow.get(\"config.neededEnergy\")\n        && !msg.payload.powerHistory.some((x) => parseFloat(x.state) <= flow.get(\"config.neededEnergy\"))\n        && msg.payload.energyForecast > flow.get(\"config.neededEnergy\")\n        && msg.payload.boilerState.attributes.current_temperature < flow.get(\"config.waterTempThreshold\")\n    ) {\n        \n        // Do not start if shortly before the EVU blocking time\n        let evuBlockMinutes = msg.payload.heatpumpState.attributes.EVU_minutes_until_next_event;\n        if (evuBlockMinutes >= 30) {\n            msg.payload.newWaterTemp = flow.get(\"config.waterTempTarget\");\n        }\n    }\n    \n    // Reset water temp setting if not enough energy is available or water temp is high\n    else {\n        msg.payload.newWaterTemp = flow.get(\"config.waterTempMinimal\");\n    }\n\n}\n\n// Heatpump is running for hot water\nelse if (msg.payload.heatpumpState.state == \"hot water\") {\n\n    // Turn off, if not enough energy is available and heat pump is running for more than \"config.pumpRuntimeMinutesMinimal\"\n    if (\n        (\n            msg.payload.powerHistory.slice(-2).every((x) => parseFloat(x.state) <= -0.3)\n        )\n        && msg.payload.heatpumpState.timeSinceChangedMs > flow.get(\"config.pumpRuntimeMinutesMinimal\") * 60 * 1000\n    ) {\n        msg.payload.newWaterTemp = flow.get(\"config.waterTempMinimal\");\n    }\n\n    // Turn on, if enough energy available and the water temp is low (after autostart through lower threshold)\n    if (\n        msg.payload.power > 0\n        && !msg.payload.powerHistory.some((x) => parseFloat(x.state) <= 0)\n        && msg.payload.energyForecast > flow.get(\"config.neededEnergy\")\n        && msg.payload.boilerState.attributes.current_temperature < flow.get(\"config.waterTempThreshold\")\n    ) {\n\n        // Do not start if shortly before the EVU blocking time (11:04 - 12:04)\n        let currentMinutesSinceMidnight = msg.payload.currentDate.getHours() * 60 + msg.payload.currentDate.getMinutes();\n        if (currentMinutesSinceMidnight < 10 * 60 + 30 || currentMinutesSinceMidnight > 11 * 60 + 30) {\n            msg.payload.newWaterTemp = flow.get(\"config.waterTempTarget\");\n        }\n    }\n\n}\n\nreturn msg;",
