  {
    "id": "bee674e5555b6d78",
    "type": "function",
    "z": "9c6446beabe43dbf",
    "g": "812aab6abc58993f",
    "name": "Automatik",
    "func": "msg.payload.newChargerCurrent = msg.payload.chargerCurrent;\nmsg.payload.newPhases = msg.payload.phases;\n\n// **********\n// * Start charging\n// **********\nif (msg.payload.chargerState == \"connected_requesting\") {\n\n    // Start charging with 3 phases\n    if (\n        msg.payload.power > flow.get(\"config.thresholdPhase3\")\n        && !msg.payload.powerHistory.some((x) => parseFloat(x.state) <= flow.get(\"config.thresholdPhase3\"))\n    ) {\n        msg.payload.newChargerCurrent = 6;\n        msg.payload.newPhases = 3;\n        msg.payload.logentry = \"Start\";\n        msg.payload.state.startTimestamp = Date.now();\n    }\n    // Start charging with 1 phase\n    else if (\n        msg.payload.power > flow.get(\"config.thresholdPhase1\")\n        && !msg.payload.powerHistory.some((x) => parseFloat(x.state) <= flow.get(\"config.thresholdPhase1\"))\n    ) {\n        msg.payload.newChargerCurrent = 6;\n        msg.payload.newPhases = 1;\n        msg.payload.logentry = \"Start\";\n        msg.payload.state.startTimestamp = Date.now();\n    }\n\n}\n\n// **********\n// * Adjust charging\n// **********\nif (\n    msg.payload.chargerState == \"connected_charging\" &&\n    (\n        msg.payload.state.startTimestamp == undefined ||\n        msg.payload.state.startTimestamp < Date.now() - 120000 // Last start was more than 2mins ago\n    )\n) {\n\n    // Determine lowest and highest power value in history and current\n    msg.payload.lowestPower = msg.payload.powerHistory.reduce((min, x) => Math.min(min, parseFloat(x.state)), 10);\n    msg.payload.lowestPower = Math.min(msg.payload.lowestPower, msg.payload.power);\n    msg.payload.highestPower = msg.payload.powerHistory.reduce((max, x) => Math.max(max, parseFloat(x.state)), -10);\n    msg.payload.highestPower = Math.max(msg.payload.highestPower, msg.payload.power);\n\n    // *** Handle 1 phase charging\n    if (msg.payload.phases < 3) {\n        \n        // Adjust power up 1 phase\n        if (\n            msg.payload.lowestPower > flow.get(\"config.thresholdAdjustPhase1\")\n        ) { \n            msg.payload.newChargerCurrent += Math.floor(msg.payload.lowestPower / flow.get(\"config.thresholdAdjustPhase1\"));\n            msg.payload.logentry = \"Adjust up\";\n            if (msg.payload.newChargerCurrent > 16) {\n                msg.payload.newChargerCurrent = 16;\n                msg.payload.logentry = undefined; // no log entry due no change\n\n                // Check if phase switch is needed\n                if (\n                    msg.payload.power > flow.get(\"config.thresholdAdjustPhase3\") // small cap of 230 W to avoid early swiching (hysteresis)\n                    && !msg.payload.powerHistory.some((x) => parseFloat(x.state) <= flow.get(\"config.thresholdAdjustPhase3\"))\n                ) {\n                    // Phase switch to 3 phases\n                    msg.payload.newChargerCurrent = 6;\n                    msg.payload.newPhases = 3;\n                    msg.payload.logentry = \"Phaseswitch up\";\n                    msg.payload.state.startTimestamp = Date.now();\n                }\n            }\n        }\n\n        // Adjust power down 1 phase\n        if (\n            msg.payload.highestPower < 0\n        ) {\n            msg.payload.newChargerCurrent -= Math.ceil(msg.payload.lowestPower * -1 / flow.get(\"config.thresholdAdjustPhase1\"));\n            msg.payload.logentry = \"Adjust down\";\n            if (msg.payload.newChargerCurrent < 6) {\n                msg.payload.newChargerCurrent = 0;\n                msg.payload.logentry = \"Stop\";\n            }\n        }\n\n    }\n\n    // *** Handle 3 phases charging\n    else if (msg.payload.phases >= 3) {\n\n        // Adjust power up 3 phases\n        if (\n            msg.payload.lowestPower > flow.get(\"config.thresholdAdjustPhase3\")\n        ) {\n            msg.payload.newChargerCurrent += Math.floor(msg.payload.lowestPower / flow.get(\"config.thresholdAdjustPhase3\"));\n            msg.payload.logentry = \"Adjust up\";\n            if (msg.payload.newChargerCurrent > 16) {\n                msg.payload.newChargerCurrent = 16;\n                msg.payload.logentry = undefined; // no log entry due no change\n            }\n        }\n\n        // Adjust power down 3 phases\n        if (\n            msg.payload.highestPower < 0\n        ) {\n            msg.payload.newChargerCurrent -= Math.ceil(msg.payload.lowestPower * -1 / flow.get(\"config.thresholdAdjustPhase3\"));\n            msg.payload.logentry = \"Adjust down\";\n            if (msg.payload.newChargerCurrent < 6) {\n\n                // Phase switch\n                msg.payload.newChargerCurrent = 16;\n                msg.payload.newPhases = 1;\n                msg.payload.logentry = \"Phaseswitch down\";\n                msg.payload.state.startTimestamp = Date.now();\n            }\n        }\n    }\n\n    // Error\n    else {\n        node.error(\"Error with number of phases: \" + msg.payload.phases, msg);\n    }\n}\n                \nreturn msg;",
