    "func": "// Init Logarray\nif (!Array.isArray(flow.get(\"log\"))) {\n    flow.set(\"log\", []);\n}\nif (flow.get(\"log\").length == 0) {\n    flow.get(\"log\").push([]);\n}\n\n// **********\n// * Write logentry if available\n// **********\nif (msg.payload.logentry !== undefined && msg._fth === undefined) {\n    \n    // New logentryarray if starting\n    if (msg.payload.logentry == \"Start\") {\n        flow.get(\"log\").unshift([]);\n    }\n\n    // Create logentry\n    let logentry = {\n        \"date\": new Date().toLocaleString(\"de-CH\"),\n        \"action\": msg.payload.logentry,\n        \"chargersetting\": msg.payload.newPhases.toString() + \" • \" + msg.payload.newChargerCurrent.toString() + \" A\",\n        \"payload\": msg.payload\n    }\n\n    // Save logentry\n    let logarray = flow.get(\"log\");\n    let logentryarray = logarray[0];\n    logentryarray.unshift(logentry);\n\n    // Shorten log if needed\n    if (logarray.length > 10) {\n        logarray = logarray.slice(0, 10);\n    }\n\n    // Save log\n    flow.set(\"log\", logarray);\n}\n\nreturn msg;",
