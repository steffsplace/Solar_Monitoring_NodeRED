    "g": "85dfa01b330fbbd4",
    "name": "Heating Logic",
    "func": "// **********\n// * Initialize\n// **********\n\n// Return Values\nmsg.payload.newWaterTemp = msg.payload.boilerState.attributes.temperature;\nmsg.payload.newHeatingTempTarget = msg.payload.heatingTarget;\n\n// Determine EVU Blocking\nlet isEvuBlockComming = ((parseFloat(msg.payload.heatpumpState.attributes.EVU_minutes_until_next_event)) == Number.NaN) ? false : parseFloat(msg.payload.heatpumpState.attributes.EVU_minutes_until_next_event) < flow.get(\"config.pumpRuntimeMinutesMinimal\");\n\n// Determine Pump Runtime\nlet isPumpRuntimeEnough = msg.payload.heatpumpState.timeSinceChangedMs > flow.get(\"config.pumpRuntimeMinutesMinimal\") * 60 * 1000\n\n// **********\n// * Determine Energy\n// **********\nlet isHeatingForced = msg.payload.boilerState.attributes.temperature == flow.get(\"config.waterTempTarget\") || msg.payload.heatingTarget == flow.get(\"config.heatingTempTargetOverheat\");\nlet isEnergyForecaseEnough = (msg.payload.energyForecast ?? 999) > flow.get(\"config.neededEnergy\");\nlet isEnergyEnough = false;\n\nif (msg.payload.heatpumpState.state != \"hot water\" && msg.payload.heatpumpState.state != \"heating\") {\n\n    // heatpump not working\n    isEnergyEnough = (\n        msg.payload.power > flow.get(\"config.neededEnergy\")\n        && msg.payload.powerHistory.every((x) => parseFloat(x.state) > flow.get(\"config.neededEnergy\"))\n    );\n} else {\n    \n    // heatpump heating\n    if (isHeatingForced) {\n        isEnergyEnough = msg.payload.powerHistory.slice(-2).every((x) => parseFloat(x.state) <= flow.get(\"config.energyThresholdWhileForcedRunning\"))\n    } else {\n        isEnergyEnough = (\n            msg.payload.power > flow.get(\"config.energyThresholdForForcingWhileRunning\")\n            && msg.payload.powerHistory.every((x) => parseFloat(x.state) > flow.get(\"config.energyThresholdForForcingWhileRunning\"))\n        );\n    }\n}\n\nlet logAction = \"No Changes Made\";\n\n// **********\n// * Starting Events\n// **********\nif (isEnergyEnough && isEnergyForecaseEnough && !isEvuBlockComming) {\n    \n    // Water Temp low => start boiler\n    if (msg.payload.boilerState.attributes.current_temperature < flow.get(\"config.waterTempThreshold\")) {\n        msg.payload.newWaterTemp = flow.get(\"config.waterTempTarget\");\n        logAction = \"Start Boiler\";\n    }\n\n    // Water Temp high => start heater\n    else if (\n        msg.payload.boilerState.attributes.current_temperature >= flow.get(\"config.waterTempTarget\")\n        || (msg.payload.heatpumpState.state != \"hot water\" && msg.payload.boilerState.attributes.current_temperature > flow.get(\"config.waterTempThreshold\"))\n    ) {\n        msg.payload.newHeatingTempTarget = flow.get(\"config.heatingTempTargetOverheat\");\n        logAction = \"Start Heater\";\n    }\n}\n\n// **********\n// * Stopping Events\n// **********\nif (!isEnergyEnough && isPumpRuntimeEnough) {\n    msg.payload.newWaterTemp = flow.get(\"config.waterTempMinimal\");\n    msg.payload.newHeatingTempTarget = flow.get(\"config.heatingTempTargetMinimal\");\n    logAction = \"Stop Boiler & Heater\";\n}\n\n// **********\n// * Debugging\n// **********\nmsg.payload.logentry = logAction + \":\\n\" + JSON.stringify({\n    datettime: (new Date()).toLocaleString(\"de-ch\"),\n    state: msg.payload.heatpumpState.state,\n    isEnergyEnough: isEnergyEnough + \" (\" + msg.payload.power + \" | \" + msg.payload.powerHistory.reduce((r, e) => r += e.state + \" \", \"\") + \")\",\n    isEnergyForecaseEnough: isEnergyForecaseEnough + \" (\" + msg.payload.energyForecast + \")\",\n    isEvuBlockComming: isEvuBlockComming + \" (\" + msg.payload.heatpumpState.attributes.EVU_minutes_until_next_event + \")\",\n    isHeatingForced: isHeatingForced + \" (W:\" + msg.payload.boilerState.attributes.temperature + \" H:\" + msg.payload.heatingTarget + \")\",\n    isPumpRuntimeEnough: isPumpRuntimeEnough + \" (\" + msg.payload.heatpumpState.timeSinceChangedMs + \")\",\n    currentWaterTemp: msg.payload.boilerState.attributes.current_temperature,\n    newWaterTemp: msg.payload.newWaterTemp,\n    newHeatingTempTarget: msg.payload.newHeatingTempTarget\n}, null, 2);\n\nreturn msg;",
